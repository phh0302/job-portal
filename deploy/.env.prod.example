# ===== Bắt buộc =====
# Tên miền (không có https://), vd: jobportal.vn
DOMAIN=jobportal.example.com
# Email nhận thông báo từ Let's Encrypt
ACME_EMAIL=admin@example.com
# Mật khẩu SA của SQL Server: >= 8 ký tự, có chữ hoa, thường, số, ký tự đặc biệt
DB_PASSWORD=Doi_Mat_Khau_Manh_123!
DB_DATABASE=job_portal
# Chuỗi ngẫu nhiên >= 32 ký tự: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=

# ===== Seed: tạo admin + danh mục + gói dịch vụ (chạy lại nhiều lần không trùng) =====
RUN_SEED=true
# Bản trình diễn / dự án sinh viên: true = tạo dữ liệu & tài khoản demo (mật khẩu Demo@123)
SEED_DEMO=false
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# ===== Email (khuyên dùng khi chạy thật; cần thêm nodemailer: npm i nodemailer trong api) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=JobPortal <no-reply@example.com>

# Express (miễn phí, DB tối đa 10GB) | Web | Standard ... (theo giấy phép của bạn)
MSSQL_PID=Express
# RAM tối đa cho SQL Server (MB). VPS 4GB: 2048
MSSQL_MEMORY_LIMIT_MB=2048

# ===== AI đề xuất việc làm (tùy chọn) =====
# AI tùy chọn: AI_PROVIDER để trống (Claude nếu có key) | ollama | none
AI_PROVIDER=
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
