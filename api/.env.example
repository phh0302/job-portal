# ===== App =====
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ===== SQL Server =====
DB_HOST=localhost
DB_PORT=1433
# Bản Express thường là instance SQLEXPRESS -> điền DB_INSTANCE=SQLEXPRESS (bỏ trống nếu là instance mặc định MSSQLSERVER)
DB_INSTANCE=
DB_USERNAME=sa
# Mật khẩu tài khoản sa (đặt khi cài SQL Server – xem README › Khắc phục sự cố)
DB_PASSWORD=Doi_MatKhau_123!
DB_DATABASE=job_portal
# true nếu dùng Azure SQL
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true
# CHỈ bật khi dev nhanh; dùng migration cho môi trường thật
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ===== Xác thực =====
WEB_URL=http://localhost:5173
# Chuỗi bí mật ngẫu nhiên, dài >= 32 ký tự. Tạo nhanh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_ACCESS_EXPIRES=15m
# Refresh token lưu trong DB (bảng refresh_tokens), gửi qua cookie httpOnly
JWT_REFRESH_EXPIRES=7d

# ===== Email (SMTP) =====
# Để trống SMTP_HOST -> email chỉ in ra console của API (tiện khi dev)
# Muốn gửi thật: npm i nodemailer, rồi điền thông tin SMTP (vd Gmail App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=JobPortal <no-reply@jobportal.local>
# Email được xếp vào hàng đợi (bảng email_outbox) và gửi nền, tự thử lại khi lỗi. false = gửi trực tiếp
MAIL_QUEUE=true

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== Upload =====
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ===== Seed =====
SEED_ADMIN_EMAIL=admin@jobportal.local
SEED_ADMIN_PASSWORD=Admin@123
# false = không tạo dữ liệu demo
SEED_DEMO=true

# ===== Job alert =====
# false = tắt gửi email việc làm định kỳ
JOB_ALERTS_ENABLED=true

# ===== Vận hành =====
# Đặt "true" (hoặc số proxy) khi chạy sau Nginx/IIS để lấy đúng IP người dùng
TRUST_PROXY=
# false = chỉ log request lỗi (4xx/5xx)
LOG_REQUESTS=true
# Bật Swagger trên production (mặc định tắt)
SWAGGER=false

# ===== E2E test (npm run test:e2e) — database riêng, bị xóa sạch mỗi lần chạy =====
E2E_DB_DATABASE=job_portal_e2e

# ===== AI (tùy chọn): nhận xét việc làm gợi ý, kiểm tra CV với JD, chấm CV, trợ lý hỗ trợ =====
# Không bật AI: các tính năng vẫn chạy bằng so khớp từ khoá / FAQ.
# AI_PROVIDER:
#   (để trống) – dùng Claude nếu có ANTHROPIC_API_KEY, không thì tắt AI
#   ollama     – mô hình mở chạy ngay trên máy (miễn phí, không cần key, dữ liệu không rời máy).
#                Cài: chạy scripts\cai-ollama.cmd (hoặc https://ollama.com, rồi `ollama pull qwen2.5:7b`)
#   none       – tắt AI
# Chỉ gửi dữ liệu đã ẩn danh (kỹ năng/kinh nghiệm/mong muốn – không gửi họ tên, email, SĐT).
AI_PROVIDER=
# Claude – lấy key tại https://console.anthropic.com
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# Ollama – qwen2.5:7b cần ~6GB RAM trống; máy yếu dùng qwen2.5:3b (~3GB)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Thời gian chờ mỗi lần gọi (ms). Máy chỉ có CPU có thể mất 1–3 phút/lần
OLLAMA_TIMEOUT_MS=300000
